{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "enabledMcpjsonServers": ["jira"],
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "mcp__plugin_github_github__delete_repository",
      "mcp__plugin_github_github__delete_file",
      "mcp__plugin_github_github__merge_pull_request",
      "Bash(gh pr merge:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "mcp__plugin_github_github__push_files",
      "mcp__plugin_github_github__create_or_update_file",
      "mcp__plugin_github_github__create_repository",
      "mcp__plugin_github_github__fork_repository"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git check-ignore:*)",
      "Bash(git branch --show-current)",
      "Bash(git switch:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(py -3 .claude/scripts/jira.py brief:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_bash.py\"", "timeout": 90 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit.py\"", "timeout": 120 }
        ]
      }
    ]
  }
}

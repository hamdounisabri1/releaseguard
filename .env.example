# Copy to .env and fill in local values. Never commit .env.
# Application variables are listed in docs/DEVELOPMENT_LIFECYCLE.md §14.6
# and are added here as each one is introduced (Sprint 1 onward).
#
# Tooling credentials (GITHUB_PERSONAL_ACCESS_TOKEN for the github plugin,
# JIRA_URL / JIRA_EMAIL / JIRA_API_TOKEN for the jira MCP server) do NOT go here:
# they live in your OS user environment. See docs/AI_TOOLING.md.

# --- Backend core (SCRUM-18) ---
# local | ci | production. Unset means production (https SITE_ORIGIN, CORS_ORIGINS ignored).
ENV=local
# Required. Public origin of the app (scheme://host[:port], no path); the CSRF Origin check
# accepts unsafe requests only from it. Must be https when ENV=production.
SITE_ORIGIN=http://localhost:3000
# Comma-separated extra origins for CORS and the Origin check. Used only when ENV=local
# (frontend on :3000, API on :8000).
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# Login throttling (SCRUM-110): failures allowed per (email, client IP) and per client IP
# within the window before /auth/login answers 429 too_many_attempts.
# LOGIN_MAX_FAILURES_PER_ACCOUNT=5
# LOGIN_MAX_FAILURES_PER_IP=30
# LOGIN_THROTTLE_WINDOW_SECONDS=900
# IPs or CIDRs of the reverse proxy (Caddy) allowed to set X-Forwarded-For. Empty (local dev):
# the socket peer is the client IP. Required in production, where every request arrives from
# Caddy (the API logs a warning without it). Never "*": clients could then choose their own IP.
# Start uvicorn with --no-proxy-headers so this is the only proxy trust setting.
TRUSTED_PROXIES=
# Required. PostgreSQL for the API and worker (SCRUM-19). Tests use TEST_DATABASE_URL instead
# (a separate database the test run rebuilds from the migrations).
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/releaseguard
# The local compose db (infra/docker-compose.yml, SCRUM-32). Required by compose; keep it in step
# with DATABASE_URL above. The compose backend builds its own URL from these (host `db`).
POSTGRES_USER=postgres
# Set POSTGRES_PASSWORD to the password in DATABASE_URL above.
POSTGRES_PASSWORD=
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/releaseguard_test
# Password of the seeded local users (python -m app.scripts.seed). Local only; default releaseguard-dev.
# SEED_PASSWORD=releaseguard-dev

# --- Frontend (SCRUM-26) ---
# The ONLY variable exposed to the browser; never prefix anything else NEXT_PUBLIC_*.
# Next.js reads it from frontend/.env.local (copy this line there for `pnpm dev`).
# Unset, it defaults to the same-origin /api/v1 used behind Caddy in production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- GitHub App (backend + worker only; never NEXT_PUBLIC_*) ---
# Development App setup: docs/GITHUB_APP_SETUP.md
GITHUB_APP_ID=
# Absolute path to the App's private key (.pem), stored OUTSIDE the repository.
GITHUB_APP_PRIVATE_KEY_PATH=
# Random 32-byte hex string; the same value is set in the App's webhook settings.
GITHUB_WEBHOOK_SECRET=

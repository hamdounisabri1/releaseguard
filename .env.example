# Copy to .env and fill in local values. Never commit .env.
# Application variables are listed in docs/DEVELOPMENT_LIFECYCLE.md §14.6
# and are added here as each one is introduced (Sprint 1 onward).
#
# Tooling credentials (GITHUB_PERSONAL_ACCESS_TOKEN for the github plugin,
# JIRA_URL / JIRA_EMAIL / JIRA_API_TOKEN for the jira MCP server) do NOT go here:
# they live in your OS user environment. See docs/AI_TOOLING.md.

# --- Backend core (SCRUM-18) ---
# local | ci | production
ENV=local
# Required. Public origin of the app (scheme://host[:port], no path); the CSRF Origin check
# accepts unsafe requests only from it. Must be https when ENV=production.
SITE_ORIGIN=http://localhost:3000
# Comma-separated extra origins for CORS and the Origin check. Used only when ENV=local
# (frontend on :3000, API on :8000).
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- GitHub App (backend + worker only; never NEXT_PUBLIC_*) ---
# Development App setup: docs/GITHUB_APP_SETUP.md
GITHUB_APP_ID=
# Absolute path to the App's private key (.pem), stored OUTSIDE the repository.
GITHUB_APP_PRIVATE_KEY_PATH=
# Random 32-byte hex string; the same value is set in the App's webhook settings.
GITHUB_WEBHOOK_SECRET=
